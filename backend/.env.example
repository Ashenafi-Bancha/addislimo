# Addis Limo API — copy to .env and fill in.
#
# Nothing here has a working default on purpose: a backend that starts with a
# guessed database URL or a default session secret is a backend that reaches
# production with one.

# ── Server ──
PORT=4100
NODE_ENV=development

# ── Database ──
# A PostgreSQL connection string. The role needs CREATE on the schema for
# `pnpm migrate` to run.
DATABASE_URL=postgres://addislimo:addislimo@localhost:5432/addislimo
# Set to `require` against a managed database (Neon, Supabase, RDS).
DATABASE_SSL=disable

# ── Sessions ──
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 32 characters. Changing it signs every admin out.
SESSION_SECRET=
# How long an admin stays signed in, in hours.
SESSION_HOURS=12

# ── CORS ──
# Comma-separated origins allowed to call the API with credentials. The
# frontend's dev server and its deployed URL.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# ── First admin ──
# `pnpm seed` creates this account if no admin exists. The password is read
# once and stored as a scrypt hash; it is never logged.
SEED_ADMIN_EMAIL=admin@addislimo.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Operations Admin
