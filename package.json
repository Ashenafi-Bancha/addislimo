{
  "name": "addislimo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Addis Limo — premium chauffeur and transportation platform for Addis Ababa. Monorepo: React frontend (live) + Node/Express + Postgres backend (planned).",
  "scripts": {
    "dev": "pnpm --filter @addislimo/frontend dev",
    "build": "pnpm --filter @addislimo/frontend build",
    "start": "node server.mjs",
    "preview": "pnpm --filter @addislimo/frontend preview",
    "typecheck": "pnpm --filter @addislimo/frontend typecheck",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3"
}
